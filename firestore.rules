rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'ADMIN';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ─── Users collection ──────────────────────────────────────────────────────
    // Each document ID = Firebase UID
    match /users/{uid} {
      // Any authenticated user can read their own profile; admins can read all
      allow read: if isOwner(uid) || isAdmin();

      // Only the backend (Admin SDK) writes user docs – deny all client writes
      allow write: if false;

      // Device tokens sub-collection
      match /device_tokens/{tokenId} {
        allow read:  if isOwner(uid) || isAdmin();
        allow write: if false; // backend-only
      }
    }

    // ─── Notifications collection ──────────────────────────────────────────────
    match /notifications/{notifId} {
      // Users can read their own notifications; admins can read all
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      // Allow users to mark their own notification as read
      allow update: if isSignedIn() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt']);

      // Only backend creates / deletes notifications
      allow create, delete: if false;
    }

    // ─── Robots live-telemetry mirror ─────────────────────────────────────────
    // The backend mirrors robot telemetry here for real-time frontend subscriptions.
    match /robots/{robotId} {
      allow read: if isSignedIn();
      allow write: if false; // backend-only
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
