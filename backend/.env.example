NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://smartpest:smartpest@localhost:5432/smartpest?schema=public"
CORS_ORIGIN="http://localhost:3000,exp://127.0.0.1:8083,http://localhost:8081,http://localhost:19006"
PUBLIC_API_URL="http://localhost:4000"
UPLOAD_PROVIDER="local"
LOCAL_UPLOAD_DIR="uploads"

# Firebase Admin SDK - telecharger depuis Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Cle partagee avec le firmware IoT du robot
IOT_API_KEY="smartpest-iot-secret-key-change-in-production"

ADMIN_SETUP_KEY="smartpest-admin-2024"

SMS_PROVIDER="disabled"
SMS_FROM=""
