NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://smartpest:smartpest@localhost:5432/smartpest?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-min-24-chars"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000,exp://127.0.0.1:8083,http://localhost:8081"
PUBLIC_API_URL="http://localhost:4000"
UPLOAD_PROVIDER="local"
LOCAL_UPLOAD_DIR="uploads"

# Firebase — get these from console.firebase.google.com
# Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# IoT car shared secret — must match the key flashed on the robot firmware
IOT_API_KEY="smartpest-iot-secret-key-change-in-production"

# S3 (optional, leave empty to use local storage)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

SMS_PROVIDER="disabled"
SMS_FROM=""
